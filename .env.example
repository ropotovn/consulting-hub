# shtab — Supabase (copy to .env.local and fill in real values)

# Project URL — https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_URL=

# anon / public key — safe to expose in the client bundle (RLS enforces access)
VITE_SUPABASE_ANON_KEY=

# service_role key — SERVER ONLY (cron scripts, edge functions). NEVER in the bundle.
SUPABASE_SERVICE_ROLE_KEY=
